{
  "expo": {
    "name": "Fitoo",
    "slug": "sobat",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "sobat",
      "com.varad.sobat"
    ],
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1017",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.varad.sobat",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "ACTIVITY_RECOGNITION"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B86F5",
          "defaultChannel": "sobat"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitoo needs your photos to read the food in a meal picture.",
          "cameraPermission": "Fitoo needs the camera to read the food on your plate.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fitoo uses the camera to read a barcode or the food on your plate."
        }
      ],
      "./plugins/withReleaseSigning.js",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Roz thoda, fit sada. Local-first health companion: calories, food photos, sleep, joint-safe fitness and gentle reminders. Runs on Android and Windows, uses your own Ollama for AI.",
    "primaryColor": "#5B86F5",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#111F1C"
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyB3Q628mgS6-s_vSOsmAEEsNmu9gJXwBGs",
        "authDomain": "sobat-a56c7.firebaseapp.com",
        "projectId": "sobat-a56c7",
        "storageBucket": "sobat-a56c7.firebasestorage.app",
        "messagingSenderId": "761404659186",
        "appId": "1:761404659186:web:9f37dcfb38570b6fc9876b"
      },
      "google": {
        "webClientId": "",
        "androidClientId": ""
      },
      "push": {
        "relayUrl": "",
        "vapidPublicKey": "BCwCri232dn5dL8BgxWj2BeTE5v-N7GSpEX1TgKns8nzwk3zPpN4Z0XWKK_U4Qx0EIRdUVt3849xMbefS9LcjMA"
      }
    }
  }
}
